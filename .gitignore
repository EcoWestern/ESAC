# Jekyll output. The site is built in CI and deployed from an artifact, so nothing
# generated should ever be committed.
_site/
.jekyll-cache/
.jekyll-metadata
Gemfile.lock

# Editor and OS noise.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Local scratch. Held-out evaluation material is evaluator-controlled and must never be
# committed, here or in a suite repository.
*.local.json
.heldout/
heldout-key*.json
*.heldout.json
.env
.env.*
